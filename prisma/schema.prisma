// Multi-tenant worldbuilding schema (PostgreSQL).
// Production-ready: ownership, role-based collaboration, comments, S3/MinIO asset keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  displayName   String?
  avatarKey     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedWorlds   World[]            @relation("WorldOwner")
  memberships   WorldMembership[]
  comments      Comment[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Role hierarchy: VIEWER < COMMENTOR < EDITOR < OWNER.
// Owner is stored both as World.ownerId and as a WorldMembership row with OWNER role.
enum WorldRole {
  VIEWER
  COMMENTOR
  EDITOR
  OWNER
}

model WorldMembership {
  id        String    @id @default(cuid())
  worldId   String
  userId    String
  role      WorldRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
  @@index([worldId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comments — generic threaded comments attached to any in-world entity.
// entityType + entityId is a soft polymorphic reference into the world.
// ---------------------------------------------------------------------------
enum CommentEntity {
  WORLD
  REGION
  CHARACTER
  FACTION
  EVENT
  WIKI
  MAP
  MAP_PIN
  FAMILY_TREE
  FAMILY_MEMBER
}

model Comment {
  id         String        @id @default(cuid())
  worldId    String
  authorId   String
  entityType CommentEntity
  entityId   String
  body       String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  world  World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// World - top level container for everything
// ---------------------------------------------------------------------------
model World {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  tagline     String?
  description String?
  coverImage  String?  // storage object key, e.g. "covers/123.png"
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation("WorldOwner", fields: [ownerId], references: [id])
  memberships WorldMembership[]
  comments    Comment[]

  regions      Region[]
  characters   Character[]
  factions     Faction[]
  events       TimelineEvent[]
  wikiPages    WikiPage[]
  maps         WorldMap[]
  familyTrees  FamilyTree[]

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Region / Zone
// ---------------------------------------------------------------------------
model Region {
  id          String   @id @default(cuid())
  worldId     String
  name        String
  description String?
  rulerId     String?
  resources   String?
  settlements String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world      World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  ruler      Character? @relation("RegionRuler", fields: [rulerId], references: [id], onDelete: SetNull)

  factions    RegionFaction[]
  characters  Character[]      @relation("CharacterCurrentRegion")
  events      TimelineEvent[]
  wikiLinks   WikiPage[]       @relation("RegionWikiLinks")
  maps        WorldMap[]

  @@index([worldId])
}

// ---------------------------------------------------------------------------
// Faction
// ---------------------------------------------------------------------------
model Faction {
  id          String   @id @default(cuid())
  worldId     String
  name        String
  banner      String?
  description String?
  motto       String?
  alignment   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world       World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  members     Character[]      @relation("CharacterFaction")
  regions     RegionFaction[]
  events      TimelineEvent[]
  wikiLinks   WikiPage[]       @relation("FactionWikiLinks")

  @@index([worldId])
}

model RegionFaction {
  regionId  String
  factionId String

  region  Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@id([regionId, factionId])
}

// ---------------------------------------------------------------------------
// Character
// ---------------------------------------------------------------------------
model Character {
  id           String   @id @default(cuid())
  worldId      String
  name         String
  title        String?
  portrait     String?
  biography    String?
  birthYear    Int?
  deathYear    Int?
  status       String?
  notes        String?
  factionId    String?
  currentRegionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  world         World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  faction       Faction?  @relation("CharacterFaction", fields: [factionId], references: [id], onDelete: SetNull)
  currentRegion Region?   @relation("CharacterCurrentRegion", fields: [currentRegionId], references: [id], onDelete: SetNull)

  rules         Region[]  @relation("RegionRuler")
  events        TimelineEvent[]
  wikiLinks     WikiPage[] @relation("CharacterWikiLinks")

  parentLinks   FamilyMember[] @relation("FamilyMemberPerson")

  @@index([worldId])
}

// ---------------------------------------------------------------------------
// Family Tree
// ---------------------------------------------------------------------------
model FamilyTree {
  id          String   @id @default(cuid())
  worldId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world   World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  members FamilyMember[]
  edges   FamilyEdge[]

  @@index([worldId])
}

model FamilyMember {
  id          String  @id @default(cuid())
  treeId      String
  characterId String
  x           Float?
  y           Float?

  tree      FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  character Character  @relation("FamilyMemberPerson", fields: [characterId], references: [id], onDelete: Cascade)

  edgesFrom FamilyEdge[] @relation("FromMember")
  edgesTo   FamilyEdge[] @relation("ToMember")

  @@unique([treeId, characterId])
}

model FamilyEdge {
  id       String @id @default(cuid())
  treeId   String
  fromId   String
  toId     String
  type     String

  tree   FamilyTree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  from   FamilyMember @relation("FromMember", fields: [fromId], references: [id], onDelete: Cascade)
  to     FamilyMember @relation("ToMember", fields: [toId], references: [id], onDelete: Cascade)

  @@index([treeId])
}

// ---------------------------------------------------------------------------
// Timeline events
// ---------------------------------------------------------------------------
model TimelineEvent {
  id          String   @id @default(cuid())
  worldId     String
  title       String
  description String?
  year        Int
  monthDay    String?
  era         String?
  category    String?
  regionId    String?
  factionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world      World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  region     Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  faction    Faction?   @relation(fields: [factionId], references: [id], onDelete: SetNull)
  characters Character[]
  wikiLinks  WikiPage[] @relation("EventWikiLinks")
  pins       MapPin[]

  @@index([worldId, year])
}

// ---------------------------------------------------------------------------
// Wiki
// ---------------------------------------------------------------------------
model WikiPage {
  id          String   @id @default(cuid())
  worldId     String
  title       String
  slug        String
  category    String
  tags        String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world      World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  characters Character[]      @relation("CharacterWikiLinks")
  regions    Region[]         @relation("RegionWikiLinks")
  factions   Faction[]        @relation("FactionWikiLinks")
  events     TimelineEvent[]  @relation("EventWikiLinks")
  pins       MapPin[]

  outgoingLinks WikiLink[] @relation("LinkFrom")
  incomingLinks WikiLink[] @relation("LinkTo")

  @@unique([worldId, slug])
  @@index([worldId, category])
}

model WikiLink {
  id     String @id @default(cuid())
  fromId String
  toId   String

  from WikiPage @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   WikiPage @relation("LinkTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// ---------------------------------------------------------------------------
// Maps
// ---------------------------------------------------------------------------
model WorldMap {
  id          String   @id @default(cuid())
  worldId     String
  parentMapId String?
  regionId    String?
  name        String
  description String?
  imagePath   String   // storage object key, e.g. "maps/123.png"
  width       Int      @default(2000)
  height      Int      @default(1500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world     World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parent    WorldMap?  @relation("NestedMaps", fields: [parentMapId], references: [id], onDelete: SetNull)
  children  WorldMap[] @relation("NestedMaps")
  region    Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  pins      MapPin[]

  @@index([worldId])
}

model MapPin {
  id        String  @id @default(cuid())
  mapId     String
  label     String
  x         Float
  y         Float
  color     String?
  icon      String?
  linkType  String

  regionId    String?
  characterId String?
  eventId     String?
  wikiPageId  String?
  childMapId  String?

  map         WorldMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  event       TimelineEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  wikiPage    WikiPage?       @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)

  @@index([mapId])
}
