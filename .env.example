# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=worldbuilder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=worldbuilder
# Used by Prisma directly. Override the host/port if you point at a remote DB.
DATABASE_URL="postgresql://worldbuilder:changeme@localhost:5432/worldbuilder?schema=public"

# ---- NextAuth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="please-generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- MinIO / S3-compatible object storage --------------------------------
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=world-builder
